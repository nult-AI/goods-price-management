POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=goods_db
POSTGRES_PORT=5436

# Security
SECRET_KEY=nult-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local connection (localhost because we are running outside docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/goods_db
REDIS_URL=redis://localhost:6383/0